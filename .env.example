# Supabase (get these after creating a project at supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # server-only, never exposed to client

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-key

# Models — pinned to avoid silent drift
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6

# Auth — single user for now
APP_OWNER_EMAIL=jose.romero@calii.com

# Public site URL (used by sign-out redirect; in dev, http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
